ask = [
    "Bash(git push --force*)",
    "Bash(git push -f *)",
]

[cli]
installer = "internal"

[marketplace]
default_skills_installs_purged = true
official_marketplace_auto_installed = true

[[marketplace.sources]]
name = "xAI Official"
git = "https://github.com/xai-org/plugin-marketplace.git"

[ui]
max_thoughts_width = 120
fork_secondary_model = "grok-4.6"
yolo = false
compact_mode = false
screen_mode = "fullscreen"
show_timeline = true
permission_mode = "auto"
keep_text_selection = "word_select"

[privacy]
privacy_banner_acked = "2026-09-05T01:59:09Z"
