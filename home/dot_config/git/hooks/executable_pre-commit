#!/usr/bin/env zsh

# secretlint config
# SEE: https://github.com/secretlint/secretlint/blob/master/docs/configuration.md
CONFIG='{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    }
  ]
}'

# fail the hook when git diff itself fails, not only when secretlint finds something
setopt pipe_fail

# check staged changes: NUL-separated and after --, so any file name stays one path argument
git diff --cached --name-only -z --diff-filter=d | xargs -0 secretlint --secretlintrc <(echo "$CONFIG") --
